# Transactional email for the contact form
RESEND_API_KEY=your_resend_api_key_here

# Optional: Umami analytics. Must be NEXT_PUBLIC_* — the script tag is client-side.
NEXT_PUBLIC_UMAMI_DOMAIN=
NEXT_PUBLIC_UMAMI_SITE_ID=

# Optional: Google Search Console HTML-tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
